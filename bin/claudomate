#!/usr/bin/env bash
# claudomate - Claude Code automation CLI for any repo

VERSION="0.2.7"
TMUX_BIN="/opt/homebrew/bin/tmux"
TMUX_SOCK="/tmp/tmux-$(id -u)/default"

# ── helpers ──────────────────────────────────────────────────────────────────

_die()  { echo "claudomate: error: $*" >&2; exit 1; }
_info() { echo "$*"; }

_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || echo "$PWD"
}

_repo_label_base() {
  local repo="$1"
  local name=$(basename "$repo")
  local hash=$(echo "$repo" | md5 | cut -c1-6)
  echo "com.claudomate.${name}_${hash}"
}

_load_config() {
  local repo="$1"
  local cfg="$repo/.claudomate/config"
  [[ -f "$cfg" ]] || _die "not installed in $(basename "$repo"). Run: claudomate install"
  source "$cfg"
}

# ── plist generation ──────────────────────────────────────────────────────────

_write_heartbeat_plist() {
  local repo="$1"
  local label="$2"
  local plist_dir="$3"
  local script="$repo/claudomate/scripts/heartbeat.sh"
  local plist="$plist_dir/${label}.plist"

  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${script}</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>${repo}/logs/heartbeat.log</string>

    <key>StandardErrorPath</key>
    <string>${repo}/logs/heartbeat_errors.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
EOF
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_install() {
  local repo=$(_repo_root)
  local base_label=$(_repo_label_base "$repo")
  local window=$(basename "$repo")
  local plist_dir="$repo/claudomate/launchd"
  local scripts_dir="$repo/claudomate/scripts"

  mkdir -p "$plist_dir" "$scripts_dir" "$repo/.claudomate"

  # Write .claudomate/config (gitignored)
  cat > "$repo/.claudomate/config" <<EOF
REPO_PATH="$repo"
REPO_LABEL="$base_label"
WINDOW="$window"
PLIST_DIR="$plist_dir"
EOF

  # Ensure logs dir
  mkdir -p "$repo/logs"
  [[ -f "$repo/logs/.gitkeep" ]] || touch "$repo/logs/.gitkeep"

  # Create HEARTBEAT.md if missing
  if [[ ! -f "$repo/HEARTBEAT.md" ]]; then
    cat > "$repo/HEARTBEAT.md" <<'HEREDOC'
# Heartbeat Instructions

Read these instructions and execute them one by one.

## Tasks

- Append a line to `logs/HEARTBEAT_LOG.md` in this repo with the current date/time and a heartbeat message. Format: `YYYY-MM-DD HH:MM: Heartbeat OK.`
HEREDOC
    _info "  created HEARTBEAT.md"
  fi

  # Create claudomate/scripts/start.sh if missing
  if [[ ! -f "$scripts_dir/start.sh" ]]; then
    cat > "$scripts_dir/start.sh" <<EOF
#!/usr/bin/env zsh
# Ensures the tmux window for this repo exists with Claude running.
REPO="\$(cd "\$(dirname "\$0")/../.." && pwd)"
TMUX_BIN="${TMUX_BIN}"
TMUX_SOCK="/tmp/tmux-\$(id -u)/default"
WINDOW="\$(basename "\$REPO")"
CLAUDE_BIN="\$(command -v claude || echo /opt/homebrew/bin/claude)"

if \$TMUX_BIN -S "\$TMUX_SOCK" list-windows -F '#{window_name}' 2>/dev/null | grep -q "^\${WINDOW}\$"; then
  echo "Window '\$WINDOW' already running."
else
  echo "Creating window '\$WINDOW' with Claude..."
  \$TMUX_BIN -S "\$TMUX_SOCK" new-window -n "\$WINDOW" \
    "cd \$REPO && \$CLAUDE_BIN --model haiku --dangerously-skip-permissions"
fi
EOF
    chmod +x "$scripts_dir/start.sh"
    _info "  created claudomate/scripts/start.sh"
  fi

  # Create .claudomate/scripts/heartbeat.sh if missing
  if [[ ! -f "$scripts_dir/heartbeat.sh" ]]; then
    cat > "$scripts_dir/heartbeat.sh" <<EOF
#!/usr/bin/env bash
# Runs on a schedule via launchd. Works without claudomate installed.
REPO="\$(cd "\$(dirname "\$0")/../.." && pwd)"
TMUX_BIN="${TMUX_BIN}"
TMUX_SOCK="/tmp/tmux-\$(id -u)/default"
WINDOW="\$(basename "\$REPO")"
FILE="\$REPO/HEARTBEAT.md"

[[ -f "\$FILE" ]] || { echo "heartbeat.sh: \$FILE not found" >&2; exit 1; }

prompt="Read the file \$FILE and execute every task listed in it."
\$TMUX_BIN -S "\$TMUX_SOCK" send-keys -t "\$WINDOW" "/new" Enter
sleep 2
\$TMUX_BIN -S "\$TMUX_SOCK" send-keys -t "\$WINDOW" "\$prompt" Enter
EOF
    chmod +x "$scripts_dir/heartbeat.sh"
    _info "  created claudomate/scripts/heartbeat.sh"
  fi

  # Generate and install plist
  _write_heartbeat_plist "$repo" "${base_label}.heartbeat" "$plist_dir"
  _info "  installed launchd plist → claudomate/launchd/"

  # Write install.sh for manual use by collaborators
  cat > "$plist_dir/install.sh" <<'INSTALL'
#!/usr/bin/env bash
# Manually load all claudomate launchd plists in this directory.
# Run this if you don't have claudomate installed.
DIR="$(cd "$(dirname "$0")" && pwd)"
for plist in "$DIR"/*.plist; do
  [[ -e "$plist" ]] || continue
  launchctl load "$plist" && echo "loaded: $(basename "$plist")"
done
INSTALL
  chmod +x "$plist_dir/install.sh"
  _info "  wrote claudomate/launchd/install.sh"

  # Load job
  launchctl load "$plist_dir/${base_label}.heartbeat.plist"
  _info "  loaded launchd job"

  echo ""
  echo "claudomate installed in $(basename "$repo")."
  echo ""
  echo "Edit HEARTBEAT.md to customize your automation, or add new jobs by"
  echo "creating <JOB>.md and claudomate/scripts/<job>.sh."
  echo "Run 'claudomate start' to ensure the Claude tmux window is running."
}

cmd_uninstall() {
  local repo=$(_repo_root)
  _load_config "$repo"

  for job in heartbeat; do
    local label="${REPO_LABEL}.${job}"
    local plist="$PLIST_DIR/${label}.plist"
    if [[ -f "$plist" ]]; then
      launchctl unload "$plist" 2>/dev/null || true
      rm -f "$plist"
      _info "  removed $label"
    fi
  done

  rm -f "$repo/.claudomate/config"
  _info "claudomate uninstalled from $(basename "$repo")."
}

cmd_load() {
  local repo=$(_repo_root)
  _load_config "$repo"
  local job="${1:-}"

  if [[ -n "$job" ]]; then
    launchctl load "$PLIST_DIR/${REPO_LABEL}.${job}.plist"
    _info "loaded $job"
  else
    launchctl load "$PLIST_DIR/${REPO_LABEL}.heartbeat.plist"
    _info "loaded heartbeat"
  fi
}

cmd_unload() {
  local repo=$(_repo_root)
  _load_config "$repo"
  local job="${1:-}"

  if [[ -n "$job" ]]; then
    launchctl unload "$PLIST_DIR/${REPO_LABEL}.${job}.plist" 2>/dev/null || true
    _info "unloaded $job"
  else
    launchctl unload "$PLIST_DIR/${REPO_LABEL}.heartbeat.plist" 2>/dev/null || true
    _info "unloaded heartbeat"
  fi
}

cmd_reload() {
  cmd_unload "$@"
  cmd_load "$@"
}

cmd_run() {
  local job="${1:-}"
  [[ -n "$job" ]] || _die "usage: claudomate run <job>"
  local repo=$(_repo_root)
  _load_config "$repo"
  launchctl start "${REPO_LABEL}.${job}"
}

cmd_logs() {
  local job="${1:-}"
  [[ -n "$job" ]] || _die "usage: claudomate logs <job>"
  local repo=$(_repo_root)
  tail -f "$repo/logs/${job}.log"
}

cmd_list() {
  local repo=$(_repo_root)
  _load_config "$repo"
  local plists=("$PLIST_DIR"/${REPO_LABEL}.*.plist)
  if [[ ! -e "${plists[0]}" ]]; then
    echo "(no claudomate plists installed for $(basename "$repo"))"
    return
  fi
  printf "%-60s %s\n" "LABEL" "STATUS"
  for plist in "${plists[@]}"; do
    local label=$(basename "$plist" .plist)
    if launchctl list "$label" &>/dev/null; then
      printf "%-60s %s\n" "$label" "loaded"
    else
      printf "%-60s %s\n" "$label" "unloaded"
    fi
  done
}

cmd_status() {
  local repo=$(_repo_root)
  _load_config "$repo"
  launchctl list | grep "$REPO_LABEL" || echo "(no claudomate jobs loaded for $(basename "$repo"))"
}

cmd_start() {
  local repo=$(_repo_root)
  _load_config "$repo"
  local claude_bin=$(command -v claude || echo /opt/homebrew/bin/claude)

  if $TMUX_BIN -S "$TMUX_SOCK" list-windows -F '#{window_name}' 2>/dev/null | grep -q "^${WINDOW}$"; then
    _info "window '$WINDOW' already running."
  else
    _info "creating window '$WINDOW' with Claude..."
    $TMUX_BIN -S "$TMUX_SOCK" new-window -n "$WINDOW" \
      "cd $REPO_PATH && $claude_bin --model haiku --dangerously-skip-permissions"
  fi
}

cmd_trigger() {
  local job="${1:-}"
  [[ -n "$job" ]] || _die "usage: claudomate trigger <job>"

  local repo=$(_repo_root)
  local script="$repo/claudomate/scripts/${job}.sh"
  [[ -f "$script" ]] || _die "no script found for job '$job': $script"
  exec bash "$script"
}

cmd_version() {
  echo "claudomate $VERSION"
}

cmd_help() {
  cat <<'EOF'
claudomate - Claude Code automation for any repo

Usage:
  claudomate <command> [args]

Commands:
  install           Set up claudomate in the current repo
  uninstall         Remove claudomate from the current repo
  start             Ensure tmux window with Claude is running
  load   [job]      Load launchd job(s)
  unload [job]      Unload launchd job(s)
  reload [job]      Reload launchd job(s)
  run    <job>      Trigger a job immediately via launchctl
  logs   <job>      Tail logs for a job
  list              Show installed claudomate plists and their load status
  status            Show all loaded claudomate jobs (raw launchctl output)
  version           Print version

Jobs: heartbeat (add more by creating <JOB>.md and a matching launchd plist)
EOF
}

# ── dispatch ──────────────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  install)            cmd_install   "$@" ;;
  uninstall)          cmd_uninstall "$@" ;;
  start)              cmd_start     "$@" ;;
  load)               cmd_load      "$@" ;;
  unload)             cmd_unload    "$@" ;;
  reload)             cmd_reload    "$@" ;;
  run)                cmd_run       "$@" ;;
  logs)               cmd_logs      "$@" ;;
  list)               cmd_list      "$@" ;;
  status)             cmd_status    "$@" ;;
  trigger)            cmd_trigger   "$@" ;;
  version|--version)  cmd_version      ;;
  help|--help|-h)     cmd_help         ;;
  *) _die "unknown command: $cmd. Run 'claudomate help' for usage." ;;
esac
