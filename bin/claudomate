#!/usr/bin/env bash
# claudomate - Claude Code automation CLI for any repo

VERSION="0.2.8"
TMUX_BIN="/opt/homebrew/bin/tmux"

# ── helpers ──────────────────────────────────────────────────────────────────

_die()  { echo "claudomate: error: $*" >&2; exit 1; }
_info() { echo "$*"; }

_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || echo "$PWD"
}

_repo_label_base() {
  local repo="$1"
  local name=$(basename "$repo")
  local hash=$(echo "$repo" | md5 | cut -c1-6)
  echo "com.claudomate.${name}_${hash}"
}

# ── plist generation ──────────────────────────────────────────────────────────

_write_heartbeat_plist() {
  local repo="$1"
  local label="$2"
  local plist_dir="$3"
  local script="$repo/claudomate/scripts/heartbeat.sh"
  local plist="$plist_dir/${label}.plist"

  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${script}</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>${repo}/logs/heartbeat.log</string>

    <key>StandardErrorPath</key>
    <string>${repo}/logs/heartbeat_errors.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
EOF
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_install() {
  local repo=$(_repo_root)
  local base_label=$(_repo_label_base "$repo")
  local plist_dir="$repo/claudomate/launchd"
  local scripts_dir="$repo/claudomate/scripts"

  mkdir -p "$plist_dir" "$scripts_dir"

  # Ensure logs dir
  mkdir -p "$repo/logs"
  [[ -f "$repo/logs/.gitkeep" ]] || touch "$repo/logs/.gitkeep"

  # Create HEARTBEAT.md if missing
  if [[ ! -f "$repo/HEARTBEAT.md" ]]; then
    cat > "$repo/HEARTBEAT.md" <<'HEREDOC'
# Heartbeat Instructions

Read these instructions and execute them one by one.

## Tasks

- Append a line to `logs/HEARTBEAT_LOG.md` in this repo with the current date/time and a heartbeat message. Format: `YYYY-MM-DD HH:MM: Heartbeat OK.`
HEREDOC
    _info "  created HEARTBEAT.md"
  fi

  # Create claudomate/scripts/start.sh if missing
  if [[ ! -f "$scripts_dir/start.sh" ]]; then
    cat > "$scripts_dir/start.sh" <<EOF
#!/usr/bin/env zsh
# Ensures the tmux window for this repo exists with Claude running.
REPO="\$(cd "\$(dirname "\$0")/../.." && pwd)"
TMUX_BIN="${TMUX_BIN}"
TMUX_SOCK="/tmp/tmux-\$(id -u)/default"
WINDOW="\$(basename "\$REPO")"
CLAUDE_BIN="\$(command -v claude || echo /opt/homebrew/bin/claude)"

if \$TMUX_BIN -S "\$TMUX_SOCK" list-windows -F '#{window_name}' 2>/dev/null | grep -q "^\${WINDOW}\$"; then
  echo "Window '\$WINDOW' already running."
else
  echo "Creating window '\$WINDOW' with Claude..."
  \$TMUX_BIN -S "\$TMUX_SOCK" new-window -n "\$WINDOW" \
    "cd \$REPO && \$CLAUDE_BIN --model haiku --dangerously-skip-permissions"
fi
EOF
    chmod +x "$scripts_dir/start.sh"
    _info "  created claudomate/scripts/start.sh"
  fi

  # Create claudomate/scripts/heartbeat.sh if missing
  if [[ ! -f "$scripts_dir/heartbeat.sh" ]]; then
    cat > "$scripts_dir/heartbeat.sh" <<EOF
#!/usr/bin/env bash
# Runs on a schedule via launchd. Works without claudomate installed.
REPO="\$(cd "\$(dirname "\$0")/../.." && pwd)"
TMUX_BIN="${TMUX_BIN}"
TMUX_SOCK="/tmp/tmux-\$(id -u)/default"
WINDOW="\$(basename "\$REPO")"
FILE="\$REPO/HEARTBEAT.md"

[[ -f "\$FILE" ]] || { echo "heartbeat.sh: \$FILE not found" >&2; exit 1; }

prompt="Read the file \$FILE and execute every task listed in it."
\$TMUX_BIN -S "\$TMUX_SOCK" send-keys -t "\$WINDOW" "/new" Enter
sleep 2
\$TMUX_BIN -S "\$TMUX_SOCK" send-keys -t "\$WINDOW" "\$prompt" Enter
EOF
    chmod +x "$scripts_dir/heartbeat.sh"
    _info "  created claudomate/scripts/heartbeat.sh"
  fi

  # Generate and install plist
  _write_heartbeat_plist "$repo" "${base_label}.heartbeat" "$plist_dir"
  _info "  installed launchd plist → claudomate/launchd/"

  # Write install.sh for manual use by collaborators
  cat > "$plist_dir/install.sh" <<'INSTALL'
#!/usr/bin/env bash
# Manually load all claudomate launchd plists in this directory.
# Run this if you don't have claudomate installed.
DIR="$(cd "$(dirname "$0")" && pwd)"
for plist in "$DIR"/*.plist; do
  [[ -e "$plist" ]] || continue
  launchctl load "$plist" && echo "loaded: $(basename "$plist")"
done
INSTALL
  chmod +x "$plist_dir/install.sh"
  _info "  wrote claudomate/launchd/install.sh"

  # Load job
  launchctl load "$plist_dir/${base_label}.heartbeat.plist"
  _info "  loaded launchd job"

  echo ""
  echo "claudomate installed in $(basename "$repo")."
  echo ""
  echo "Edit HEARTBEAT.md to customize your automation, or add new jobs by"
  echo "creating <JOB>.md and claudomate/scripts/<job>.sh."
  echo "Run claudomate/scripts/start.sh to ensure the Claude tmux window is running."
}

cmd_uninstall() {
  local repo=$(_repo_root)
  local base_label=$(_repo_label_base "$repo")
  local plist_dir="$repo/claudomate/launchd"
  local plist="$plist_dir/${base_label}.heartbeat.plist"

  if [[ -f "$plist" ]]; then
    launchctl unload "$plist" 2>/dev/null || true
    _info "  unloaded ${base_label}.heartbeat"
  fi

  rm -rf "$repo/claudomate"
  _info "claudomate uninstalled from $(basename "$repo")."
}

cmd_version() {
  echo "claudomate $VERSION"
}

cmd_help() {
  cat <<'EOF'
claudomate - scaffold tmux/launchd Claude automation into any repo

Usage:
  claudomate <command>

Commands:
  install     Scaffold heartbeat scripts and launchd plist into the current repo
  uninstall   Unload the launchd job and remove claudomate/ from the repo
  version     Print version
EOF
}

# ── dispatch ──────────────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  install)            cmd_install   "$@" ;;
  uninstall)          cmd_uninstall "$@" ;;
  version|--version)  cmd_version      ;;
  help|--help|-h)     cmd_help         ;;
  *) _die "unknown command: $cmd. Run 'claudomate help' for usage." ;;
esac
